# Copy file ini jadi ".env" (buang ".example") lalu isi dengan nilai
# dari dashboard Supabase project lo (Settings > API).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Email akun admin (harus sama dengan yang dipakai login Supabase Auth
# dan yang di-whitelist di RLS policy supabase-setup.sql).
# Di production: set juga di Vercel → Project → Settings → Environment Variables.
VITE_ADMIN_EMAIL=sporttiaphari@outlook.com
